# Postgres connection
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Or individual fields
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=tellit
DB_SSL=true

# Signs login tokens; required (the server refuses to start without it). Generate: openssl rand -hex 32
JWT_SECRET=

# Logins. Passwords are stored only as bcrypt hashes (cost >= 12) from `yarn hash-password`.
# USERS="user:<hash>:role,..." with role admin (everything) or operator (no revenue/profit).
# ADMIN_USER + ADMIN_PASS_HASH adds one admin. Nothing configured = nobody can log in.
USERS=
ADMIN_USER=
ADMIN_PASS_HASH=
